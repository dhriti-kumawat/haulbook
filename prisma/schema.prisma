// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  password      String?   // For email/password auth
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Email reminders
  remindersEnabled   Boolean   @default(true)
  reminderDaysBefore Int       @default(2)
  lastDigestAt       DateTime?
  onboardedAt        DateTime?
  /// Sessions issued before this time are rejected (set on password reset).
  passwordChangedAt  DateTime?

  /// "free" or "pro". During early access everyone gets Pro features (see lib/plan.ts).
  plan               String    @default("free")

  // Billing details printed on invoices for paid collabs
  billingName        String?
  billingAddress     String?
  billingEmail       String?
  billingPhone       String?
  billingUpi         String?
  billingBank        String?
  billingGstin       String?
  billingPan         String?

  /// WhatsApp reminders: number in E.164 (+91…) and when the user agreed to messages.
  whatsappNumber     String?
  whatsappOptInAt    DateTime?

  pushSubscriptions PushSubscription[]
  orders   Order[]
  passwordResets PasswordResetToken[]
  products Product[]
  shops    Shop[]
  accounts Account[]
  sessions Session[]
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id        String   @id @default(cuid())
  sessionToken String @unique
  userId    String
  expires   DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Order {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  orderID             String
  platform            String
  status              String   // e.g., "Pending", "Delivered", "Picked Up"
  amount              Float
  orderedDate         DateTime @default(now())
  deliveryDate        DateTime?
  
  subProducts         SubProduct[]
  customPlatforms     Json?
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  @@index([userId])
}

model SubProduct {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  productName     String
  price           Float?
  returnDeadline  DateTime?
  delivery        DateTime?
  policyDays      Int      @default(7)
  returned        Boolean  @default(false)
  returnedDate    DateTime?
  kept            Boolean  @default(false)
  keptDate        DateTime?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([orderId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Shop {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  policyDays Int      @default(7)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, name])
}

/// One product a creator is reviewing: bought, sent as PR, or part of a paid collab.
/// Each step is a timestamp; null means the step is not done yet.
model Product {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  title            String
  type             String    @default("bought") // "bought" | "pr" | "collab"
  shop             String?   // where it was bought, or the brand that sent it
  url              String?
  imageUrl         String?
  price            Float?    // what the creator paid (bought)
  fee              Float?    // what the brand pays (collab)
  deliverables     String?   // e.g. "1 Reel + 2 stories"
  notes            String?

  orderedAt        DateTime  @default(now())
  deliveredAt      DateTime?
  filmedAt         DateTime?
  postedAt         DateTime?
  postUrl          String?
  returnedAt       DateTime?
  refundedAt       DateTime?
  keptAt           DateTime?
  paidAt           DateTime?
  /// Invoice number for paid collabs, assigned the first time an invoice is made (per user).
  invoiceNumber    Int?
  invoicedAt       DateTime?

  returnWindowDays Int?
  returnBy         DateTime? // explicit return deadline; otherwise deliveredAt + returnWindowDays
  postBy           DateTime?
  isSample         Boolean   @default(false) // example data added during onboarding

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([userId])
}

/// One-time password reset link. Only a hash of the token is stored.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// One browser or phone that turned on notifications. Removed when the push service says it is gone.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  device    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Shared rate-limit counters, so limits hold across every server instance (fixed window per key).
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

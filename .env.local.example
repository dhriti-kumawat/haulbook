# Database (local Postgres, or Neon/Supabase in production)
DATABASE_URL="postgresql://user:password@localhost:5432/haulbook"

# NextAuth — NEXTAUTH_URL is also used to build links in emails
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Google sign-in (optional; the Google button only shows when both are set)
GOOGLE_ID=""
GOOGLE_SECRET=""

# Instagram sign-in (optional; Meta app with "Instagram API with Instagram Login").
# Redirect URI: <NEXTAUTH_URL>/api/auth/callback/instagram. Works for Business and Creator accounts only.
INSTAGRAM_CLIENT_ID=""
INSTAGRAM_CLIENT_SECRET=""

# Phone code sign-in via Twilio Verify (optional). In development without these, codes print in the server log.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SID=""

# Email via Resend (optional locally: without a key, emails appear at /api/dev/outbox)
RESEND_API_KEY=""
EMAIL_FROM="Haulbook <reminders@your-domain.com>"

# Protects the daily reminder job. Vercel Cron sends it automatically when set.
CRON_SECRET="generate-with: openssl rand -hex 32"

# Link import fallbacks, used only when a shop blocks a direct read or hides details behind JavaScript.
# Jina Reader (open source: github.com/jina-ai/reader). Works without a key at a low rate; a free key raises it.
# Set READER_URL to your own copy's address, or READER_URL=off to turn it off.
READER_URL=
READER_API_KEY=
# Microlink (open source core: github.com/microlinkhq/metascraper). About 50 free links a day without a key.
MICROLINK_API_KEY=
MICROLINK=

# Phone and browser notifications (Web Push). Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, as mailto: or https: URL.
VAPID_SUBJECT=mailto:you@example.com

# Voice add ("Or just say it" in Add product). Claude turns what the creator said into form fields.
# Without a key, a simpler built-in reader fills in what it can (name, shop, price, return days).
ANTHROPIC_API_KEY=

# Free/Pro plans. Leave unset during early access (everyone gets Pro). Set to "on" to enforce Free limits.
PLAN_LIMITS=

# WhatsApp reminders (Meta WhatsApp Cloud API). Off until both token and number ID are set.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=haulbook_digest
WHATSAPP_TEMPLATE_LANG=en
